# Copy to .env and fill in. Never commit .env.
# Full reference: docs/environment.md

# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/hostmyservice"
NEXTAUTH_SECRET=""            # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# ── VPS (customer site deployments) ───────────────────────────────────
VPS_HOST=""
VPS_USER="root"
VPS_PRIVATE_KEY=""            # node scripts/set-vps-key.mjs <key-file>
# DEPLOY_RUN_AS_ROOT="false"  # emergency escape hatch only, see docs/deployment-pipeline.md

# ── Razorpay ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""    # Razorpay Dashboard → Webhooks → secret

# ── Email (Gmail SMTP with an app password) ──────────────────────────
SMTP_EMAIL=""
SMTP_PASSWORD=""
ADMIN_EMAIL=""                # Let's Encrypt registration email

# ── Maintenance ───────────────────────────────────────────────────────
CRON_SECRET=""                # openssl rand -hex 32
# EXPIRY_ENFORCEMENT_START="2026-11-12T00:00:00Z"  # older subscriptions are never auto-expired

# ── CI/CD webhook server (scripts/webhook-server.mjs) ─────────────────
WEBHOOK_SECRET=""             # same value as the GitHub webhook secret
# WEBHOOK_PORT="9000"
# DEPLOY_BRANCH="main"
# PROJECT_DIR="/var/www/hostmyservice"

# ── Google Drive archive backup (optional) ────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN="" # node scripts/get-refresh-token.js
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=""
